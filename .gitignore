# 三模块源码采用目录白名单，避免混入原包的用户数据、旧交付和研究资料。
/modules/*
!/modules/bg/
!/modules/ai-gateway/
!/modules/experience/
/modules/bg/*
!/modules/bg/*.py
!/modules/bg/index.html
!/modules/bg/README.md
!/modules/bg/tests/
!/modules/bg/dimension-assets/
!/modules/bg/workbuddy_sample_skills/
/modules/bg/dimension-assets/previews/
/modules/ai-gateway/*
!/modules/ai-gateway/*.mjs
!/modules/ai-gateway/README.md
!/modules/ai-gateway/DEPLOY.md
!/modules/ai-gateway/src/
!/modules/ai-gateway/public/
/modules/experience/*
!/modules/experience/.gitignore
!/modules/experience/README.md
!/modules/experience/pytest.ini
!/modules/experience/start.ps1
!/modules/experience/backend/
!/modules/experience/frontend/
!/modules/experience/tests/
!/modules/experience/scripts/

