# 体验工作台 · 环境变量样例
# 复制为 .env 后按需修改。.env 不得提交到仓库。
# 说明：所有密钥仅从环境读取，绝不写入数据库；未配置外部凭证时自动使用 Mock。

# ---------- 应用 ----------
APP_NAME=体验工作台
APP_ENV=local
DEBUG=false

# ---------- 服务端口 ----------
API_HOST=127.0.0.1
API_PORT=8000
WEB_HOST=127.0.0.1
WEB_PORT=5173

# ---------- 数据库（SQLite，自动启用 WAL） ----------
# 留空则使用 <项目根>/data/uei.db
DATABASE_URL=

# ---------- 会话 ----------
# 生产环境必须替换为随机长字符串：python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-env
SESSION_COOKIE_NAME=uei_session
SESSION_MAX_AGE_SECONDS=43200
SESSION_HTTPS_ONLY=false

# ---------- CORS（逗号分隔） ----------
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# ---------- 业务开关 ----------
# UEI 得分是否封 0；默认 false（允许显示负分）
UEI_CLAMP_ZERO_DEFAULT=false

# ---------- Provider（默认 mock；禁止真实外部调用） ----------
# 取值：mock | feishu | ai
# 若选择 feishu/ai 但未提供相应凭证，运行时自动降级为 mock
PROVIDER_MODE=mock

# 飞书（留空即视为未配置）
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# AI（留空即视为未配置）
AI_API_KEY=
AI_ENDPOINT=
