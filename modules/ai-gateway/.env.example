# The token WorkBuddy sends as: Authorization: Bearer <token>
# Leave blank to generate a temporary token at every startup.
WORKBUDDY_GATEWAY_TOKEN=

# Bind to loopback by default. Change only when the gateway is behind TLS/firewall.
WORKBUDDY_HOST=127.0.0.1
WORKBUDDY_PORT=4317

# Semicolon-separated directories Codex is allowed to work in.
# Windows example: C:\code\project-a;D:\repos\project-b
WORKBUDDY_ALLOWED_ROOTS=C:\path\to\your\repositories

# Limits
WORKBUDDY_MAX_CONCURRENCY=2
WORKBUDDY_TASK_TIMEOUT_MS=1800000
WORKBUDDY_MAX_PROMPT_CHARS=20000

# Cloud AI employees. Prefer scripts/configure-agents.ps1 so these do not enter
# shell history. Environment variables take precedence when explicitly set.
ARK_API_KEY=
MOONSHOT_API_KEY=
WORKBUDDY_DOUBAO_MODEL=doubao-seed-2-1-lite-260915
WORKBUDDY_KIMI_MODEL=kimi-k3

# WorkBuddy itself is not registered as an employee right now (2026-11-02).
# When its API arrives, just add a normal employee in the dashboard:
# Base URL + model id + API key. No env vars or code changes needed.

# Local Claude Code employee. Left blank it auto-detects the native exe under
# %APPDATA%\npm\node_modules\@anthropic-ai\claude-code\bin. Set it only if you
# installed Claude Code somewhere else.
# WORKBUDDY_CLAUDE_PATH=C:\path\to\claude.exe

